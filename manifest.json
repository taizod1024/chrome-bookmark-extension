{
  "manifest_version": 3,
  "name": "Bookmark Extension",
  "version": "1.0.0",
  "description": "View and edit your bookmarks in panels organized by folder.",
  "permissions": ["bookmarks", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open chrome bookmark extension"
  }
}
